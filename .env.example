VITE_API_BASE_URL=http://localhost:8787/api
VITE_WS_URL=ws://localhost:8787/ws

# Server-global process, infrastructure, identity, and scheduling settings.
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
JWT_SECRET=replace-me-in-development
CLIENT_URL=http://localhost:5173
MYSQL_URL=mysql://echoo:echoo@127.0.0.1:3306/echoo
MYSQL_POOL_SIZE=20
REDIS_URL=redis://127.0.0.1:6379
AGENT_RUN_CONCURRENCY=8
MESSAGE_CACHE_MAX_PER_CONVERSATION=200
MESSAGE_CACHE_TTL_MS=21600000
RESOURCE_STORAGE_DIR=.data/resources
RESOURCE_STORAGE_PROVIDER=local
# S3/MinIO production storage. Required when RESOURCE_STORAGE_PROVIDER=s3.
RESOURCE_S3_ENDPOINT=http://127.0.0.1:9000
RESOURCE_S3_REGION=us-east-1
RESOURCE_S3_BUCKET=echoo-private
RESOURCE_S3_ACCESS_KEY_ID=echoo
RESOURCE_S3_SECRET_ACCESS_KEY=echoo-local-secret
RESOURCE_S3_FORCE_PATH_STYLE=true
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Echoo <onboarding@resend.dev>
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Echoo
PRIME_SILENCE_POLL_MS=1000
