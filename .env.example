# Frontend build/dev settings. Vite reads these from the repository root.
# Changes require restarting the frontend dev server or rebuilding the client.
VITE_API_BASE_URL=http://localhost:8787/api
VITE_WS_URL=ws://localhost:8787/ws

# Server process and identity settings. Changes require a server restart.
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# Required in production. Use a long random value shared by all server instances.
JWT_SECRET=replace-me-in-development
CLIENT_URL=http://localhost:5173
MYSQL_URL=mysql://echoo:echoo@127.0.0.1:3306/echoo
MYSQL_POOL_SIZE=20
REDIS_URL=redis://127.0.0.1:6379
AGENT_RUN_CONCURRENCY=8
MESSAGE_CACHE_MAX_PER_CONVERSATION=200
MESSAGE_CACHE_TTL_MS=21600000
PRIME_SILENCE_POLL_MS=1000

# Resource storage. Local mode only uses RESOURCE_STORAGE_DIR.
RESOURCE_STORAGE_PROVIDER=s3
RESOURCE_STORAGE_DIR=.data/resources
# S3-compatible mode requires bucket and credentials. Endpoint is omitted for AWS S3.
RESOURCE_S3_ENDPOINT=http://127.0.0.1:9000
RESOURCE_S3_REGION=us-east-1
RESOURCE_S3_BUCKET=echoo-private
RESOURCE_S3_ACCESS_KEY_ID=echoo
RESOURCE_S3_SECRET_ACCESS_KEY=echoo-local-secret
RESOURCE_S3_FORCE_PATH_STYLE=true
# Keep downloads behind the authenticated Echoo API unless the object endpoint is
# browser-reachable over HTTPS and has an appropriate CORS policy.
RESOURCE_S3_DIRECT_DOWNLOADS=false

# Optional integrations. Missing values disable only the corresponding feature.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Echoo <onboarding@resend.dev>
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Echoo
# Missing ADMIN_PASSWORD disables the standalone /admin console.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Platform-paid provider credentials. They are resolved in memory for platform
# requests and are never copied into user or administrator runtime settings.
PLATFORM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PLATFORM_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxx
# Used when a platform text model selects the exact OpenRouter provider slug "deepseek".
PLATFORM_DEEPSEEK_API_KEY=sk-xxxxxxxxx
PLATFORM_FISH_AUDIO_HTTP_URL=https://api.fish.audio/v1/tts
PLATFORM_FISH_AUDIO_WS_URL=wss://api.fish.audio/v1/tts/live
PLATFORM_FISH_AUDIO_API_KEY=xxxxxxxxx

# Billing multiplier, model catalog/recommendations, and new-user runtime defaults
# are live settings managed in /admin and therefore do not belong in this file.
