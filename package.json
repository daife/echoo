{
  "name": "echoo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=@echoo/client",
    "dev:server": "turbo dev --filter=@echoo/server",
    "db:recreate": "pnpm --filter @echoo/server db:recreate",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.9.3"
  }
}
