{
  "name": "@echoo/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./public-assets": {
      "types": "./dist/domains/public-assets/index.d.ts",
      "import": "./dist/domains/public-assets/index.js"
    },
    "./notifications": {
      "types": "./dist/domains/notifications/index.d.ts",
      "import": "./dist/domains/notifications/index.js"
    },
    "./voice-clones": {
      "types": "./dist/domains/voice-clones/index.d.ts",
      "import": "./dist/domains/voice-clones/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
