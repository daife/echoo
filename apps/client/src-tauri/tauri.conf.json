{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echoo",
  "version": "0.1.0",
  "identifier": "com.echoo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Echoo",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
