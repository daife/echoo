{
  "name": "@echoo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/infra/database/schema.sql','dist/infra/database/schema.sql')\"",
    "start": "node dist/main.js",
    "test": "tsx --test src/modules/agents/kinds/*/*.test.ts src/modules/resources/*.test.ts src/modules/runtime-config/*.test.ts src/modules/tts/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@echoo/domain": "workspace:*",
    "@echoo/shared": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/websocket": "^11.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "fastify": "^5.6.0",
    "mysql2": "^3.22.6",
    "redis": "^6.1.0",
    "sharp": "^0.35.3",
    "ws": "^8.21.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
